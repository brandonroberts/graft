{
  "name": "@graftsync/cli",
  "version": "0.2.1",
  "description": "The graft CLI: keep local modifications to upstream npm packages in sync.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonroberts/graft.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/brandonroberts/graft#readme",
  "bugs": "https://github.com/brandonroberts/graft/issues",
  "keywords": [
    "graft",
    "cli",
    "patch",
    "npm",
    "upstream",
    "sync"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "graft": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../tools/package-readme/package-readme.mjs",
    "postpack": "node ../../tools/package-readme/package-readme.mjs --clean"
  },
  "dependencies": {
    "@graftsync/core": "workspace:*",
    "@graftsync/spec": "workspace:*",
    "citty": "^0.2.2",
    "@graftsync/adapter-patch": "workspace:*",
    "@graftsync/skill": "workspace:*",
    "@graftsync/adapter-fork": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
